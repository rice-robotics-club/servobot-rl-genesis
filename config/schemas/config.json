{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RSL RL Configuration Schema",
  "description": "JSON Schema for rsl_rl configuration YAML files.  The schema uses class_name fields to determine which sub-schema applies.",
  "$comment": "Produced with Claude Opus 4.5, use with caution.",
  "type": "object",
  "properties": {
    "runner": {
      "$ref": "#/definitions/runner"
    }
  },
  "required": ["runner"],
  "additionalProperties": false,
  "definitions": {
    "runner": {
      "type": "object",
      "description": "Runner configuration.  Use class_name to select between OnPolicyRunner and DistillationRunner.",
      "properties": {
        "class_name": {
          "type": "string",
          "enum": ["OnPolicyRunner", "DistillationRunner"],
          "description": "The runner class to use"
        },
        "num_steps_per_env": {
          "type": "integer",
          "description": "Number of steps per environment per iteration"
        },
        "max_iterations": {
          "type": "integer",
          "description": "Number of policy updates"
        },
        "seed": {
          "type": "integer",
          "description": "Random seed for reproducibility"
        },
        "obs_groups": {
          "type": "object",
          "description": "Maps observation groups to sets of observation types",
          "properties": {
            "policy": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Observation sets for the policy/actor"
            },
            "critic": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Observation sets for the critic (PPO only)"
            },
            "teacher": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Observation sets for the teacher (Distillation only)"
            }
          }
        },
        "save_interval": {
          "type": "integer",
          "description": "Check for potential saves every n iterations"
        },
        "experiment_name": {
          "type": "string",
          "description": "Name of the experiment"
        },
        "run_name": {
          "type": "string",
          "description": "Name of the specific run"
        },
        "logger": {
          "type": "string",
          "enum": ["tensorboard", "neptune", "wandb"],
          "description": "Logging backend to use"
        },
        "neptune_project": {
          "type": "string",
          "description": "Neptune project name (when logger=neptune)"
        },
        "wandb_project": {
          "type": "string",
          "description": "Weights & Biases project name (when logger=wandb)"
        },
        "policy": {
          "$ref": "#/definitions/policy"
        },
        "algorithm": {
          "$ref": "#/definitions/algorithm"
        }
      },
      "required": [
        "class_name",
        "num_steps_per_env",
        "max_iterations",
        "policy",
        "algorithm"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "class_name": { "const": "OnPolicyRunner" } }
          },
          "then": {
            "properties": {
              "policy": {
                "$ref": "#/definitions/ppo_policy"
              },
              "algorithm": {
                "$ref": "#/definitions/ppo_algorithm"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "class_name": { "const": "DistillationRunner" } }
          },
          "then": {
            "properties": {
              "policy": {
                "$ref": "#/definitions/distillation_policy"
              },
              "algorithm": {
                "$ref": "#/definitions/distillation_algorithm"
              }
            }
          }
        }
      ]
    },

    "policy": {
      "type": "object",
      "description": "Policy configuration (generic)",
      "properties": {
        "class_name": {
          "type": "string",
          "enum": [
            "ActorCritic",
            "ActorCriticCNN",
            "ActorCriticRecurrent",
            "StudentTeacher",
            "StudentTeacherRecurrent"
          ]
        }
      },
      "required": ["class_name"]
    },

    "ppo_policy": {
      "type": "object",
      "description": "Policy configuration for PPO (OnPolicyRunner)",
      "oneOf": [
        { "$ref": "#/definitions/actor_critic" },
        { "$ref": "#/definitions/actor_critic_cnn" },
        { "$ref": "#/definitions/actor_critic_recurrent" }
      ]
    },

    "distillation_policy": {
      "type": "object",
      "description": "Policy configuration for Distillation (DistillationRunner)",
      "oneOf": [
        { "$ref": "#/definitions/student_teacher" },
        { "$ref": "#/definitions/student_teacher_recurrent" }
      ]
    },

    "actor_critic": {
      "type": "object",
      "description": "ActorCritic policy for standard MLP-based actor-critic",
      "properties": {
        "class_name": {
          "const": "ActorCritic"
        },
        "activation": {
          "type": "string",
          "description": "Activation function (e.g., 'elu', 'relu', 'tanh')",
          "default": "elu"
        },
        "actor_obs_normalization": {
          "type": "boolean",
          "description": "Whether to normalize actor observations",
          "default": false
        },
        "critic_obs_normalization": {
          "type": "boolean",
          "description": "Whether to normalize critic observations",
          "default": false
        },
        "actor_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden layer dimensions for actor MLP",
          "default": [256, 256, 256]
        },
        "critic_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden layer dimensions for critic MLP",
          "default": [256, 256, 256]
        },
        "init_noise_std": {
          "type": "number",
          "description": "Initial standard deviation of action noise",
          "default": 1.0
        },
        "noise_std_type": {
          "type": "string",
          "enum": ["scalar", "log"],
          "description": "Type of noise standard deviation parameterization",
          "default": "scalar"
        },
        "state_dependent_std": {
          "type": "boolean",
          "description": "Whether action std is state-dependent",
          "default": false
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "actor_critic_cnn": {
      "type": "object",
      "description": "ActorCriticCNN policy for CNN-based actor-critic with 2D observations",
      "properties": {
        "class_name": {
          "const": "ActorCriticCNN"
        },
        "activation": {
          "type": "string",
          "description": "Activation function",
          "default": "elu"
        },
        "actor_obs_normalization": {
          "type": "boolean",
          "description": "Whether to normalize 1D actor observations",
          "default": false
        },
        "critic_obs_normalization": {
          "type": "boolean",
          "description": "Whether to normalize 1D critic observations",
          "default": false
        },
        "actor_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden layer dimensions for actor MLP",
          "default": [256, 256, 256]
        },
        "critic_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden layer dimensions for critic MLP",
          "default": [256, 256, 256]
        },
        "actor_cnn_cfg": {
          "oneOf": [
            { "$ref": "#/definitions/cnn_config" },
            {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/cnn_config" },
              "description": "Per-observation-group CNN configurations"
            }
          ],
          "description": "CNN configuration for actor 2D observations"
        },
        "critic_cnn_cfg": {
          "oneOf": [
            { "$ref": "#/definitions/cnn_config" },
            {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/cnn_config" },
              "description": "Per-observation-group CNN configurations"
            }
          ],
          "description": "CNN configuration for critic 2D observations"
        },
        "init_noise_std": {
          "type": "number",
          "default": 1.0
        },
        "noise_std_type": {
          "type": "string",
          "enum": ["scalar", "log"],
          "default": "scalar"
        },
        "state_dependent_std": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "actor_critic_recurrent": {
      "type": "object",
      "description": "ActorCriticRecurrent policy with RNN memory",
      "properties": {
        "class_name": {
          "const": "ActorCriticRecurrent"
        },
        "activation": {
          "type": "string",
          "default": "elu"
        },
        "actor_obs_normalization": {
          "type": "boolean",
          "default": false
        },
        "critic_obs_normalization": {
          "type": "boolean",
          "default": false
        },
        "actor_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "default": [256, 256, 256]
        },
        "critic_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "default": [256, 256, 256]
        },
        "init_noise_std": {
          "type": "number",
          "default": 1.0
        },
        "noise_std_type": {
          "type": "string",
          "enum": ["scalar", "log"],
          "default": "scalar"
        },
        "state_dependent_std": {
          "type": "boolean",
          "default": false
        },
        "rnn_type": {
          "type": "string",
          "enum": ["lstm", "gru"],
          "description": "Type of recurrent unit",
          "default": "lstm"
        },
        "rnn_hidden_dim": {
          "type": "integer",
          "description": "Hidden dimension of RNN",
          "default": 256
        },
        "rnn_num_layers": {
          "type": "integer",
          "description": "Number of RNN layers",
          "default": 1
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "student_teacher": {
      "type": "object",
      "description": "StudentTeacher policy for distillation",
      "properties": {
        "class_name": {
          "const": "StudentTeacher"
        },
        "activation": {
          "type": "string",
          "default": "elu"
        },
        "student_obs_normalization": {
          "type": "boolean",
          "description": "Whether to normalize student observations",
          "default": false
        },
        "teacher_obs_normalization": {
          "type": "boolean",
          "description": "Whether to normalize teacher observations",
          "default": false
        },
        "student_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden layer dimensions for student MLP",
          "default": [256, 256, 256]
        },
        "teacher_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden layer dimensions for teacher MLP",
          "default": [256, 256, 256]
        },
        "init_noise_std": {
          "type": "number",
          "default": 0.1
        },
        "noise_std_type": {
          "type": "string",
          "enum": ["scalar", "log"],
          "default": "scalar"
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "student_teacher_recurrent": {
      "type": "object",
      "description": "StudentTeacherRecurrent policy for recurrent distillation",
      "properties": {
        "class_name": {
          "const": "StudentTeacherRecurrent"
        },
        "activation": {
          "type": "string",
          "default": "elu"
        },
        "student_obs_normalization": {
          "type": "boolean",
          "default": false
        },
        "teacher_obs_normalization": {
          "type": "boolean",
          "default": false
        },
        "student_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "default": [256, 256, 256]
        },
        "teacher_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "default": [256, 256, 256]
        },
        "init_noise_std": {
          "type": "number",
          "default": 0.1
        },
        "noise_std_type": {
          "type": "string",
          "enum": ["scalar", "log"],
          "default": "scalar"
        },
        "rnn_type": {
          "type": "string",
          "enum": ["lstm", "gru"],
          "default": "lstm"
        },
        "rnn_hidden_dim": {
          "type": "integer",
          "default": 256
        },
        "rnn_num_layers": {
          "type": "integer",
          "default": 1
        },
        "teacher_recurrent": {
          "type": "boolean",
          "description": "Whether teacher is also recurrent",
          "default": false
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "algorithm": {
      "type": "object",
      "description": "Algorithm configuration (generic)",
      "properties": {
        "class_name": {
          "type": "string",
          "enum": ["PPO", "Distillation"]
        }
      },
      "required": ["class_name"]
    },

    "ppo_algorithm": {
      "type": "object",
      "description": "PPO algorithm configuration",
      "properties": {
        "class_name": {
          "const": "PPO"
        },
        "learning_rate": {
          "type": "number",
          "description": "Learning rate for the optimizer",
          "default": 0.001
        },
        "num_learning_epochs": {
          "type": "integer",
          "description": "Number of learning epochs per update",
          "default": 5
        },
        "num_mini_batches": {
          "type": "integer",
          "description": "Number of mini batches (batch_size = num_envs * num_steps / num_mini_batches)",
          "default": 4
        },
        "schedule": {
          "type": "string",
          "enum": ["adaptive", "fixed"],
          "description": "Learning rate schedule type",
          "default": "adaptive"
        },
        "clip_param": {
          "type": "number",
          "description": "PPO clipping parameter",
          "default": 0.2
        },
        "gamma": {
          "type": "number",
          "description": "Discount factor",
          "default": 0.99
        },
        "lam": {
          "type": "number",
          "description": "GAE lambda parameter",
          "default": 0.95
        },
        "value_loss_coef": {
          "type": "number",
          "description": "Value loss coefficient",
          "default": 1.0
        },
        "entropy_coef": {
          "type": "number",
          "description": "Entropy coefficient for exploration",
          "default": 0.01
        },
        "max_grad_norm": {
          "type": "number",
          "description": "Maximum gradient norm for clipping",
          "default": 1.0
        },
        "use_clipped_value_loss": {
          "type": "boolean",
          "description": "Whether to use clipped value loss",
          "default": true
        },
        "desired_kl": {
          "type": "number",
          "description": "Target KL divergence for adaptive schedule",
          "default": 0.01
        },
        "normalize_advantage_per_mini_batch": {
          "type": "boolean",
          "description": "Whether to normalize advantages per mini batch",
          "default": false
        },
        "rnd_cfg": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/rnd_config" }],
          "description": "Random Network Distillation configuration (optional)"
        },
        "symmetry_cfg": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/symmetry_config" }
          ],
          "description": "Symmetry augmentation configuration (optional)"
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "distillation_algorithm": {
      "type": "object",
      "description": "Distillation algorithm configuration",
      "properties": {
        "class_name": {
          "const": "Distillation"
        },
        "learning_rate": {
          "type": "number",
          "description": "Learning rate for the optimizer",
          "default": 0.001
        },
        "num_learning_epochs": {
          "type": "integer",
          "description": "Number of learning epochs per update",
          "default": 1
        },
        "gradient_length": {
          "type": "integer",
          "description": "Gradient length for backpropagation through time",
          "default": 15
        },
        "max_grad_norm": {
          "type": ["number", "null"],
          "description": "Maximum gradient norm for clipping (null for no clipping)",
          "default": null
        },
        "loss_type": {
          "type": "string",
          "enum": ["mse", "huber"],
          "description": "Loss function type for distillation",
          "default": "mse"
        },
        "optimizer": {
          "type": "string",
          "description": "Optimizer type (e.g., 'adam', 'sgd')",
          "default": "adam"
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "rnd_config": {
      "type": "object",
      "description": "Random Network Distillation (RND) configuration for intrinsic motivation",
      "properties": {
        "weight": {
          "type": "number",
          "description": "Initial weight/scaling factor of the RND reward",
          "default": 0.0
        },
        "weight_schedule": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/rnd_weight_schedule" }
          ],
          "description": "Weight schedule configuration"
        },
        "reward_normalization": {
          "type": "boolean",
          "description": "Whether to normalize intrinsic reward",
          "default": false
        },
        "state_normalization": {
          "type": "boolean",
          "description": "Whether to normalize input state",
          "default": false
        },
        "learning_rate": {
          "type": "number",
          "description": "Learning rate for RND predictor",
          "default": 0.001
        },
        "num_outputs": {
          "type": "integer",
          "description": "Number of outputs (embedding size). -1 uses observation dimensions",
          "default": 1
        },
        "predictor_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden dimensions of predictor network.  -1 uses num_states",
          "default": [-1]
        },
        "target_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden dimensions of target network. -1 uses num_states",
          "default": [-1]
        },
        "activation": {
          "type": "string",
          "description": "Activation function",
          "default": "elu"
        }
      },
      "additionalProperties": false
    },

    "rnd_weight_schedule": {
      "type": "object",
      "description": "Weight schedule for RND reward scaling",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["constant", "step", "linear"],
          "description": "Schedule mode type"
        },
        "initial_step": {
          "type": "integer",
          "description": "Step at which weight starts changing (linear mode)"
        },
        "final_step": {
          "type": "integer",
          "description": "Step at which weight reaches final value"
        },
        "final_value": {
          "type": "number",
          "description": "Final value of the weight parameter"
        }
      },
      "required": ["mode"],
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "step" } }
          },
          "then": {
            "required": ["final_step", "final_value"]
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "linear" } }
          },
          "then": {
            "required": ["initial_step", "final_step", "final_value"]
          }
        }
      ],
      "additionalProperties": false
    },

    "symmetry_config": {
      "type": "object",
      "description": "Symmetry augmentation configuration for exploiting environment symmetries",
      "properties": {
        "use_data_augmentation": {
          "type": "boolean",
          "description": "Add symmetric trajectories to the batch",
          "default": false
        },
        "use_mirror_loss": {
          "type": "boolean",
          "description": "Add symmetry loss term to the loss function",
          "default": false
        },
        "data_augmentation_func": {
          "type": ["string", "null"],
          "description": "Module and function path to import (e.g., 'module.path: function_name')"
        },
        "mirror_loss_coeff": {
          "type": "number",
          "description": "Coefficient for symmetry loss term",
          "default": 0.0
        }
      },
      "additionalProperties": true
    },

    "cnn_config": {
      "type": "object",
      "description": "CNN network configuration",
      "properties": {
        "output_channels": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Output channels for each convolutional layer"
        },
        "kernel_size": {
          "oneOf": [
            { "type": "integer" },
            { "type": "array", "items": { "type": "integer" } }
          ],
          "description": "Kernel size(s) for convolutional layers"
        },
        "stride": {
          "oneOf": [
            { "type": "integer" },
            { "type": "array", "items": { "type": "integer" } }
          ],
          "description": "Stride(s) for convolutional layers",
          "default": 1
        },
        "dilation": {
          "oneOf": [
            { "type": "integer" },
            { "type": "array", "items": { "type": "integer" } }
          ],
          "description": "Dilation(s) for convolutional layers",
          "default": 1
        },
        "padding": {
          "type": "string",
          "enum": ["none", "zeros", "reflect", "replicate", "circular"],
          "description": "Padding type",
          "default": "none"
        },
        "norm": {
          "oneOf": [
            { "type": "string", "enum": ["none", "batch", "layer"] },
            {
              "type": "array",
              "items": { "type": "string", "enum": ["none", "batch", "layer"] }
            }
          ],
          "description": "Normalization type(s) per layer",
          "default": "none"
        },
        "activation": {
          "type": "string",
          "description": "Activation function",
          "default": "elu"
        },
        "max_pool": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "array", "items": { "type": "boolean" } }
          ],
          "description": "Whether to apply max pooling after each layer",
          "default": false
        },
        "global_pool": {
          "type": "string",
          "enum": ["none", "max", "avg"],
          "description": "Global pooling type at the end",
          "default": "none"
        },
        "flatten": {
          "type": "boolean",
          "description": "Whether to flatten the output tensor",
          "default": true
        }
      },
      "required": ["output_channels", "kernel_size"],
      "additionalProperties": false
    }
  }
}
