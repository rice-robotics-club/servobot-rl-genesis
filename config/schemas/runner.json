{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runner.json",
  "title": "Runner_Config",
  "$comment": "Updated to reflect the nested RSL-RL structure with discrete models (actor/critic/student/teacher).",
  "type": "object",
  "description": "Runner configuration. Use class_name to select between OnPolicyRunner and DistillationRunner.",
  "properties": {
    "class_name": {
      "type": "string",
      "enum": ["OnPolicyRunner", "DistillationRunner"],
      "description": "The runner class to use"
    },
    "num_steps_per_env": {
      "type": "integer",
      "description": "Number of environment steps collected per iteration."
    },
    "obs_groups": {
      "type": "object",
      "description": "Mapping from observation sets to observation groups coming from the environment.",
      "properties": {
        "actor": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Observations used as input to the actor model."
        },
        "critic": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Observations used as input to the critic model."
        },
        "student": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Observations used as input to the student model."
        },
        "teacher": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Observations used as input to the teacher model."
        },
        "rnd_state": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Observations used as input to the RND extension."
        }
      },
      "additionalProperties": false
    },
    "save_interval": {
      "type": "integer",
      "description": "Number of iterations between checkpoints."
    },
    "logger": {
      "type": "string",
      "enum": ["tensorboard", "wandb", "neptune"],
      "default": "tensorboard",
      "description": "Logging service to use."
    },
    "wandb_project": {
      "type": "string",
      "description": "W&B project name used by the W&B writer."
    },
    "neptune_project": {
      "type": "string",
      "description": "Neptune project name used by the Neptune writer."
    },
    "run_name": {
      "type": "string",
      "description": "Optional run label shown in the console output."
    },
    "check_for_nan": {
      "type": "boolean",
      "default": true,
      "description": "Whether to check for NaN values coming from the environment."
    },
    "algorithm": {
      "$ref": "runner.json#/$defs/algorithm"
    },
    "actor": {
      "$ref": "runner.json#/$defs/model",
      "description": "Actor model configuration."
    },
    "critic": {
      "$ref": "runner.json#/$defs/model",
      "description": "Critic model configuration."
    },
    "student": {
      "$ref": "runner.json#/$defs/model",
      "description": "Student model configuration."
    },
    "teacher": {
      "$ref": "runner.json#/$defs/model",
      "description": "Teacher model configuration."
    }
  },
  "required": [
    "class_name",
    "num_steps_per_env",
    "obs_groups",
    "save_interval",
    "algorithm"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "class_name": { "const": "OnPolicyRunner" } }
      },
      "then": {
        "required": ["actor", "critic"],
        "properties": {
          "algorithm": { "$ref": "runner.json#/$defs/ppo_algorithm" }
        }
      }
    },
    {
      "if": {
        "properties": { "class_name": { "const": "DistillationRunner" } }
      },
      "then": {
        "required": ["student", "teacher"],
        "properties": {
          "algorithm": { "$ref": "runner.json#/$defs/distillation_algorithm" }
        }
      }
    },
    {
      "if": {
        "properties": { "logger": { "const": "wandb" } }
      },
      "then": {
        "required": ["wandb_project"]
      }
    },
    {
      "if": {
        "properties": { "logger": { "const": "neptune" } }
      },
      "then": {
        "required": ["neptune_project"]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "algorithm": {
      "type": "object",
      "description": "Algorithm configuration (generic)",
      "properties": {
        "class_name": {
          "type": "string",
          "enum": ["PPO", "Distillation"]
        }
      },
      "required": ["class_name"]
    },

    "ppo_algorithm": {
      "type": "object",
      "description": "PPO algorithm configuration",
      "properties": {
        "class_name": {
          "const": "PPO"
        },
        "optimizer": {
          "type": "string",
          "description": "Optimizer used for policy/value updates.",
          "default": "adam"
        },
        "learning_rate": {
          "type": "number",
          "description": "Optimizer learning rate.",
          "default": 0.001
        },
        "num_learning_epochs": {
          "type": "integer",
          "description": "Number of optimization epochs per iteration.",
          "default": 5
        },
        "num_mini_batches": {
          "type": "integer",
          "description": "Number of mini-batches per iteration.",
          "default": 4
        },
        "schedule": {
          "type": "string",
          "enum": ["adaptive", "fixed"],
          "description": "Learning-rate schedule.",
          "default": "adaptive"
        },
        "value_loss_coef": {
          "type": "number",
          "description": "Coefficient for the value-function loss.",
          "default": 1.0
        },
        "clip_param": {
          "type": "number",
          "description": "PPO clipping parameter for surrogate/value clipping.",
          "default": 0.2
        },
        "use_clipped_value_loss": {
          "type": "boolean",
          "description": "Whether to clip the value loss.",
          "default": true
        },
        "desired_kl": {
          "type": "number",
          "description": "Target KL divergence used by the adaptive learning-rate schedule.",
          "default": 0.01
        },
        "entropy_coef": {
          "type": "number",
          "description": "Entropy regularization coefficient.",
          "default": 0.01
        },
        "gamma": {
          "type": "number",
          "description": "Discount factor.",
          "default": 0.99
        },
        "lam": {
          "type": "number",
          "description": "GAE lambda parameter.",
          "default": 0.95
        },
        "max_grad_norm": {
          "type": "number",
          "description": "Maximum gradient norm for gradient clipping.",
          "default": 1.0
        },
        "normalize_advantage_per_mini_batch": {
          "type": "boolean",
          "description": "Whether to normalize advantages for each mini-batch instead of across the entire rollout.",
          "default": false
        },
        "share_cnn_encoders": {
          "type": "boolean",
          "description": "Whether to share the CNN networks between actor and critic in case CNNModel is used.",
          "default": false
        },
        "rnd_cfg": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "runner.json#/$defs/rnd_config" }
          ],
          "description": "Optional RND extension configuration.",
          "default": null
        },
        "symmetry_cfg": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "runner.json#/$defs/symmetry_config" }
          ],
          "description": "Optional symmetry extension configuration.",
          "default": null
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "distillation_algorithm": {
      "type": "object",
      "description": "Distillation algorithm configuration",
      "properties": {
        "class_name": {
          "const": "Distillation"
        },
        "optimizer": {
          "type": "string",
          "description": "Optimizer used for student updates.",
          "default": "adam"
        },
        "learning_rate": {
          "type": "number",
          "description": "Optimizer learning rate.",
          "default": 0.001
        },
        "num_learning_epochs": {
          "type": "integer",
          "description": "Number of optimization epochs per iteration.",
          "default": 1
        },
        "gradient_length": {
          "type": "integer",
          "description": "Gradient backpropagation length.",
          "default": 15
        },
        "max_grad_norm": {
          "type": ["number", "null"],
          "description": "Maximum gradient norm for gradient clipping.",
          "default": null
        },
        "loss_type": {
          "type": "string",
          "enum": ["mse", "huber"],
          "description": "Loss type.",
          "default": "mse"
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "model": {
      "type": "object",
      "description": "Model configuration (actor, critic, student, or teacher).",
      "oneOf": [
        { "$ref": "runner.json#/$defs/mlp_model" },
        { "$ref": "runner.json#/$defs/rnn_model" },
        { "$ref": "runner.json#/$defs/cnn_model" }
      ]
    },

    "mlp_model": {
      "type": "object",
      "description": "MLP Model configuration.",
      "properties": {
        "class_name": {
          "const": "MLPModel"
        },
        "hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden dimensions of the MLP.",
          "default": [256, 256, 256]
        },
        "activation": {
          "type": "string",
          "description": "Activation function of the MLP.",
          "default": "elu"
        },
        "obs_normalization": {
          "type": "boolean",
          "description": "Whether to normalize the observations before passing them to the MLP.",
          "default": false
        },
        "distribution_cfg": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "runner.json#/$defs/distribution_cfg" }
          ],
          "description": "Optional output distribution configuration.",
          "default": null
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "rnn_model": {
      "type": "object",
      "description": "RNN Model configuration.",
      "properties": {
        "class_name": {
          "const": "RNNModel"
        },
        "hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden dimensions of the MLP.",
          "default": [256, 256, 256]
        },
        "activation": {
          "type": "string",
          "description": "Activation function of the MLP.",
          "default": "elu"
        },
        "obs_normalization": {
          "type": "boolean",
          "description": "Whether to normalize the observations before passing them to the MLP.",
          "default": false
        },
        "distribution_cfg": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "runner.json#/$defs/distribution_cfg" }
          ],
          "description": "Optional output distribution configuration.",
          "default": null
        },
        "rnn_type": {
          "type": "string",
          "enum": ["lstm", "gru"],
          "description": "Type of RNN network.",
          "default": "lstm"
        },
        "rnn_hidden_dim": {
          "type": "integer",
          "description": "Hidden dimension of the RNN.",
          "default": 256
        },
        "rnn_num_layers": {
          "type": "integer",
          "description": "Number of RNN layers.",
          "default": 1
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "cnn_model": {
      "type": "object",
      "description": "CNN Model configuration.",
      "properties": {
        "class_name": {
          "const": "CNNModel"
        },
        "hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden dimensions of the MLP.",
          "default": [256, 256, 256]
        },
        "activation": {
          "type": "string",
          "description": "Activation function of the MLP.",
          "default": "elu"
        },
        "obs_normalization": {
          "type": "boolean",
          "description": "Whether to normalize the observations before passing them to the MLP.",
          "default": false
        },
        "distribution_cfg": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "runner.json#/$defs/distribution_cfg" }
          ],
          "description": "Optional output distribution configuration.",
          "default": null
        },
        "cnn_cfg": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "runner.json#/$defs/cnn_config" },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "runner.json#/$defs/cnn_config"
              },
              "description": "Per-observation-group CNN configurations"
            }
          ],
          "description": "Configuration of the CNN encoder(s).",
          "default": null
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "distribution_cfg": {
      "type": "object",
      "description": "Distribution configuration for stochastic outputs.",
      "properties": {
        "class_name": {
          "type": "string",
          "enum": ["GaussianDistribution", "HeteroscedasticGaussianDistribution"],
          "description": "Distribution class name."
        },
        "init_std": {
          "type": "number",
          "description": "Initial standard deviation.",
          "default": 1.0
        },
        "std_type": {
          "type": "string",
          "enum": ["scalar", "log"],
          "description": "Parameterization of the standard deviation.",
          "default": "scalar"
        }
      },
      "required": ["class_name"],
      "additionalProperties": false
    },

    "rnd_config": {
      "type": "object",
      "description": "Random Network Distillation (RND) configuration.",
      "properties": {
        "weight": {
          "type": "number",
          "description": "Initial weight of the RND reward.",
          "default": 0.0
        },
        "weight_schedule": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "runner.json#/$defs/rnd_weight_schedule" }
          ],
          "description": "Weight schedule for the RND reward."
        },
        "learning_rate": {
          "type": "number",
          "description": "Learning rate for the RND optimizer.",
          "default": 0.001
        },
        "predictor_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden dimensions of the RND predictor network."
        },
        "target_hidden_dims": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Hidden dimensions of the RND target network."
        },
        "num_outputs": {
          "type": "integer",
          "description": "Number of outputs of the RND networks."
        },
        "activation": {
          "type": "string",
          "description": "Activation function for the RND networks.",
          "default": "elu"
        },
        "state_normalization": {
          "type": "boolean",
          "description": "Whether to normalize the RND state.",
          "default": false
        },
        "reward_normalization": {
          "type": "boolean",
          "description": "Whether to normalize the RND reward.",
          "default": false
        }
      },
      "required": ["predictor_hidden_dims", "target_hidden_dims", "num_outputs"],
      "additionalProperties": false
    },

    "rnd_weight_schedule": {
      "type": "object",
      "description": "Weight schedule for RND reward scaling.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["constant", "step", "linear"],
          "description": "Schedule mode type"
        },
        "initial_step": {
          "type": "integer",
          "description": "Step at which weight starts changing (linear mode)"
        },
        "final_step": {
          "type": "integer",
          "description": "Step at which weight reaches final value"
        },
        "final_value": {
          "type": "number",
          "description": "Final value of the weight parameter"
        }
      },
      "required": ["mode"],
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "step" } } },
          "then": { "required": ["final_step", "final_value"] }
        },
        {
          "if": { "properties": { "mode": { "const": "linear" } } },
          "then": { "required": ["initial_step", "final_step", "final_value"] }
        }
      ],
      "additionalProperties": false
    },

    "symmetry_config": {
      "type": "object",
      "description": "Symmetry augmentation configuration.",
      "properties": {
        "use_data_augmentation": {
          "type": "boolean",
          "description": "Whether to add symmetric trajectories to the batch."
        },
        "data_augmentation_func": {
          "type": ["string", "null"],
          "description": "Function to generate symmetric trajectories."
        },
        "use_mirror_loss": {
          "type": "boolean",
          "description": "Whether to add a symmetry loss term to the loss function."
        },
        "mirror_loss_coeff": {
          "type": "number",
          "description": "Coefficient for the symmetry loss."
        }
      },
      "required": ["use_data_augmentation", "data_augmentation_func", "use_mirror_loss", "mirror_loss_coeff"],
      "additionalProperties": false
    },

    "cnn_config": {
      "type": "object",
      "description": "CNN network configuration.",
      "properties": {
        "output_channels": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Output channels for each convolutional layer."
        },
        "kernel_size": {
          "oneOf": [
            { "type": "integer" },
            { "type": "array", "items": { "type": "integer" } }
          ],
          "description": "Kernel size for each convolutional layer or a single kernel size for all layers."
        },
        "stride": {
          "oneOf": [
            { "type": "integer" },
            { "type": "array", "items": { "type": "integer" } }
          ],
          "description": "Stride for each convolutional layer or a single stride for all layers.",
          "default": 1
        },
        "dilation": {
          "oneOf": [
            { "type": "integer" },
            { "type": "array", "items": { "type": "integer" } }
          ],
          "description": "Dilation for each convolutional layer or a single dilation for all layers.",
          "default": 1
        },
        "padding": {
          "type": "string",
          "enum": ["none", "zeros", "reflect", "replicate", "circular"],
          "description": "Padding type to use.",
          "default": "none"
        },
        "norm": {
          "oneOf": [
            { "type": "string", "enum": ["none", "batch", "layer"] },
            {
              "type": "array",
              "items": { "type": "string", "enum": ["none", "batch", "layer"] }
            }
          ],
          "description": "Normalization type for each convolutional layer or a single normalization type for all layers.",
          "default": "none"
        },
        "activation": {
          "type": "string",
          "description": "Activation function to use.",
          "default": "elu"
        },
        "max_pool": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "array", "items": { "type": "boolean" } }
          ],
          "description": "Whether to apply max pooling after each convolutional layer or a single boolean for all layers.",
          "default": false
        },
        "global_pool": {
          "type": "string",
          "enum": ["none", "max", "avg"],
          "description": "Global pooling type to apply at the end.",
          "default": "none"
        },
        "flatten": {
          "type": "boolean",
          "description": "Whether to flatten the output tensor.",
          "default": true
        }
      },
      "required": ["output_channels", "kernel_size"],
      "additionalProperties": false
    }
  }
}
