{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "env.json",
  "title": "Env_Config",
  "description": "Configuration for the training environment",
  "type": "object",
  "properties": {
    "class_name": {
      "type": "string",
      "description": "Name of the environment class"
    },
    "robot_description_path": {
      "type": "string",
      "description": "Path to the robot description file"
    },
    "robot_description_type": {
      "type": "string",
      "enum": ["URDF", "MJCF"],
      "description": "Type of the robot file"
    },
    "joints": {
      "type": "object",
      "description": "Joint names and their default angles",
      "additionalProperties": {
        "type": "number"
      }
    },
    "kp": {
      "type": "number",
      "description": "Position proportional gain for joint PD controller"
    },
    "kd": {
      "type": "number",
      "description": "Velocity derivative gain for joint PD controller"
    },
    "termination_if_roll_greater_than": {
      "type": "number",
      "description": "Terminate episode if base roll angle exceeds this value (radians)"
    },
    "termination_if_pitch_greater_than": {
      "type": "number",
      "description": "Terminate episode if base pitch angle exceeds this value (radians)"
    },
    "base_init_pos": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Initial base position [x, y, z] in meters"
    },
    "base_init_quat": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "Initial base orientation quaternion [w, x, y, z]"
    },
    "episode_length": {
      "type": "number",
      "description": "Maximum episode length in seconds"
    },
    "resampling_time": {
      "type": "number",
      "description": "Time interval for resampling goals/actions in seconds"
    },
    "action_scale": {
      "type": "number",
      "description": "Scaling multiplier applied to actions"
    },
    "simulate_action_latency": {
      "type": "boolean",
      "description": "Whether to simulate action latency"
    },
    "clip_actions": {
      "type": "number",
      "description": "Action clipping magnitude"
    },
    "dt": {
      "type": "number",
      "description": "Time duration for each simulation step in seconds, defaults to 1e-2"
    }
  },
  "required": [
    "class_name",
    "robot_description_path",
    "robot_description_type",
    "joints",
    "episode_length",
    "resampling_time",
    "dt",
    "clip_actions",
    "kp",
    "kd",
    "action_scale",
    "base_init_pos",
    "base_init_quat"
  ],
  "additionalProperties": false
}
