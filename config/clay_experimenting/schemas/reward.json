{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reward.json",
  "title": "Reward_Config",
  "type": "object",
  "properties": {
    "tracking_sigma": {
      "type": "number",
      "description": "Standard deviation of the tracking reward"
    },
    "rewards": {
      "type": "object",
      "description": "List of rewards and their corresponding scales",
      "additionalProperties": {
        "type": "number"
      }
    },
    "targets": {
      "type": "object",
      "description": "List of target values",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": ["rewards", "targets", "tracking_sigma"],
  "additionalProperties": false
}
