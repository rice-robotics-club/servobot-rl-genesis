-# yaml-language-server: $schema=./schemas/config.json
-# Phase 5 - Natural Gait
-# Goal: slower, longer strides at low speed instead of a shuffle.
-# Key changes from phase 4:
-#   - foot_clearance reward added (biggest new signal)
-#   - action_scale increased 0.30 → 0.40 (physically allows longer strides)
-#   - action_rate penalty increased -2 → -4 (discourages rapid shuffling)
-#   - similar_to_default eased -0.1 → -0.5 (more pull back to neutral between steps,
-#     but not enough to lock the legs into small movements)
-#   - energy penalty increased -0.075 → -0.15 (many small shuffle steps are costly)
-runner:
-  class_name: OnPolicyRunner
-  num_steps_per_env: 24
-  save_interval: 100
-  seed: 1
-  obs_groups: { "policy": ["main"], "critic": ["main"] }
-  experiment_name: catbot
-  logger: tensorboard
-  neptune_project: legged_gym
-  wandb_project: legged_gym
-  max_iterations: 1000
-  run_name: ""
-
-  policy:
-    class_name: ActorCritic
-    activation: elu
-    actor_obs_normalization: true
-    critic_obs_normalization: true
-    actor_hidden_dims: [512, 256, 128]
-    critic_hidden_dims: [512, 256, 128]
-    init_noise_std: 1.0
-
-  algorithm:
-    class_name: PPO
-    learning_rate: 0.001
-    num_learning_epochs: 5
-    num_mini_batches: 4
-    schedule: adaptive
-    value_loss_coef: 1.0
-    clip_param: 0.2
-    use_clipped_value_loss: true
-    desired_kl: 0.01
-    entropy_coef: 0.01
-    gamma: 0.99
-    lam: 0.95
-    max_grad_norm: 1.0
-
-env:
-  class_name: CatbotEnv
-  robot_description_path: robots/catbot_description/robot.xml
-  robot_description_type: MJCF
-  joints:
-    BL_a: 0.0
-    BL_hip: 0.0
-    BL_l: 0.0
-    BR_a: 0.0
-    BR_hip: 0.0
-    BR_l: 0.0
-    FL_a: 0.0
-    FL_hip: 0.0
-    FL_l: 0.0
-    FR_a: 0.0
-    FR_hip: 0.0
-    FR_l: 0.0
-  base_init_pos: [0.0, 0.0, 0.4]
-  base_init_quat: [1.0, 0.0, 0.0, 0.0]
-  episode_length: 20.0
-  resampling_time: 4.0
-  action_scale: 0.40       # up from 0.30 — allows physically longer strides
-  simulate_action_latency: True
-  clip_actions: 100.0
-  dt: 0.02
-  termination_if_pitch_greater_than: 0.7
-  termination_if_roll_greater_than: 0.7
-  kp: 20.0
-  kd: 0.5
-  foot_link_names: ["160mm", "160mm_2", "160mm_3", "160mm_4"]
-  termination_if_body_contact_height: 0.05
-
-commands:
-  lin_vel_x: [-1.0, 1.0]
-  lin_vel_y: [-1.5, 1.5]
-  ang_vel_z: [-0.1, 0.1]
-
-obs:
-  num_obs: 45
-  scales:
-    lin_vel_x: 2.0
-    lin_vel_y: 2.0
-    ang_vel_z: 0.25
-    dof_pos: 1.0
-    dof_vel: 0.05
-
-reward:
-  tracking_sigma: 0.025
-  rewards:
-    tracking_lin_vel: 200
-    tracking_ang_vel: 60
-    lin_vel_z: -100
-    roll_angle: -200
-    pitch_angle: -200
-    base_height: -1000
-    action_rate: -4          # up from -2 — penalises rapid shuffling more
-    similar_to_default: -0.5 # up from -0.1 — gentle pull back to neutral between steps
-    energy: -0.15            # up from -0.075 — many small steps are expensive
-    survival: 0.3
-    foot_clearance: 60.0     # new — reward feet lifting during swing phase
-  targets:
-    base_height: 0.28        # slightly higher than phase4 to encourage clearance
