-# Phase 5 - Natural Gait
-# Goal: slower, longer strides at low speed instead of a shuffle.
-# Key changes from phase 4:
-#   - foot_clearance reward added (biggest new signal)
-#   - action_scale increased 0.30 → 0.40 (physically allows longer strides)
-#   - action_rate penalty increased -2 → -4 (discourages rapid shuffling)
-#   - similar_to_default eased -0.1 → -0.5 (more pull back to neutral between steps,
-#     but not enough to lock the legs into small movements)
-#   - energy penalty increased -0.075 → -0.15 (many small shuffle steps are costly)
-runner:
-  class_name: OnPolicyRunner
-  num_steps_per_env: 96
-  save_interval: 100
-  obs_groups: { "actor": ["main"], "critic": ["main"] }
-  logger: tensorboard
-  neptune_project: legged_gym
-  wandb_project: legged_gym
-  run_name: ""
-
-  actor:
-    class_name: MLPModel
-    activation: elu
-    obs_normalization: true
-    hidden_dims: [512, 256, 128]
-    distribution_cfg:
-      class_name: GaussianDistribution
-      init_std: 1.0
-      std_type: scalar
-
-  critic:
-    class_name: MLPModel
-    activation: elu
-    obs_normalization: true
-    hidden_dims: [512, 256, 128]
-
-  algorithm:
-    class_name: PPO
-    learning_rate: 0.001
-    num_learning_epochs: 5
-    num_mini_batches: 4
-    schedule: adaptive
-    value_loss_coef: 1.0
-    clip_param: 0.2
-    use_clipped_value_loss: true
-    desired_kl: 0.02
-    entropy_coef: 0.01
-    gamma: 0.99
-    lam: 0.95
-    max_grad_norm: 1.0
