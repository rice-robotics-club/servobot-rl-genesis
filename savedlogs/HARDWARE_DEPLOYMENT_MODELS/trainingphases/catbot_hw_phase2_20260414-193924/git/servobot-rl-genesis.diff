-# Phase 7 - Moderate DR
-# Picks up from phase 6. Reward structure unchanged.
-# Goal: cover the majority of real hardware variance — servo gain spread,
-#       surface differences, and unexpected disturbances.
-# Key additions from phase 6:
-#   - kp: ±10% range (unit-to-unit servo gain variation)
-#   - kd: ±20% range (damping more variable than stiffness on cheap servos)
-#   - friction: widened to ±40% (adds carpet and grippy rubber surfaces)
-#   - mass_shift: ±30g per link (cable routing, print density variation)
-#   - obs noise: doubled — closer to what noisy real hardware produces
-#   - pushes: enabled at low magnitude (teaches disturbance recovery)
-runner:
-  class_name: OnPolicyRunner
-  num_steps_per_env: 96
-  save_interval: 100
-  obs_groups: { "actor": ["main"], "critic": ["main"] }
-  logger: tensorboard
-  neptune_project: legged_gym
-  wandb_project: legged_gym
-  run_name: ""
-
-  actor:
-    class_name: MLPModel
-    activation: elu
-    obs_normalization: true
-    hidden_dims: [512, 256, 128]
-    distribution_cfg:
-      class_name: GaussianDistribution
-      init_std: 1.0
-      std_type: scalar
-
-  critic:
